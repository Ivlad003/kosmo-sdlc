{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/code-store-platform/agentic-sdlc/schemas/track.schema.json",
  "title": "agentic-sdlc track file frontmatter",
  "description": "YAML frontmatter contract for _/tracks/<TICKET>.md. Every cycle command reads and writes this frontmatter — the body of the markdown file is for humans.",
  "type": "object",
  "required": ["ticket", "title", "status", "created", "updated", "acs"],
  "additionalProperties": false,
  "properties": {
    "ticket": {
      "type": "string",
      "description": "Ticket identifier or freeform slug when ticketing.system is 'none'.",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "in_review", "ready_to_merge", "merged", "abandoned"]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "branch": {
      "type": ["string", "null"],
      "description": "Set by /sdlc-implement when the branch is created."
    },
    "spec": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "hash": {
          "type": ["string", "null"],
          "description": "SHA-256 of the spec slice captured at intake; /sdlc-revalidate uses it to detect drift."
        },
        "rows": {
          "type": ["string", "null"],
          "description": "Row range when the ticket references a sub-section, e.g. '131-132'."
        }
      }
    },
    "figma": {
      "type": ["string", "null"]
    },
    "pr": {
      "type": ["string", "null"],
      "description": "PR URL once /sdlc-pr opens one."
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario": { "type": ["string", "null"] },
        "recording": { "type": ["string", "null"] },
        "report": { "type": ["string", "null"] },
        "applicable": {
          "type": "boolean",
          "default": true,
          "description": "False when the feature has no UI surface; /sdlc-validate writes a 'na' report and skips recording."
        }
      }
    },
    "acs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "requirements"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text", "owner", "status"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^R[0-9]+\\.[0-9]+$" },
                "text": { "type": "string", "minLength": 1 },
                "owner": {
                  "type": "string",
                  "enum": ["backend", "frontend", "shared", "infra", "docs", "mixed"]
                },
                "status": {
                  "type": "string",
                  "enum": ["not_started", "in_progress", "done", "blocked", "na"]
                },
                "evidence": {
                  "type": ["string", "null"],
                  "description": "file:line reference or commit SHA recording where the requirement landed."
                }
              }
            }
          }
        }
      }
    },
    "phase_log": {
      "type": "array",
      "description": "One entry per cycle phase that ran. Append-only; /sdlc-cycle and individual commands both write here.",
      "items": {
        "type": "object",
        "required": ["phase", "at", "note"],
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["intake", "implement", "validate", "review", "pr", "pr-comments", "revalidate"]
          },
          "at": { "type": "string", "format": "date-time" },
          "note": { "type": "string", "minLength": 1 },
          "outcome": {
            "type": "string",
            "enum": ["pass", "fail", "partial", "skipped"]
          }
        }
      }
    }
  }
}
